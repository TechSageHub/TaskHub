{
  "Storage": {
    "Provider": "InMemory",
    "FileDirectory": "./data"
  },
  "Auth": {
    "CookieSecure": "SameAsRequest",
    "MaxAttempts": 20,
    "WindowSeconds": 60,
    "BlockSeconds": 300
  },
  "Archive": {
    "AfterDays": 30,
    "IntervalSeconds": 3600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
